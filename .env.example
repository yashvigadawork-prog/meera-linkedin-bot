# --- Telegram ---
# From @BotFather after you create the bot
TELEGRAM_BOT_TOKEN=

# Any random long string you make up yourself. Used to verify that webhook
# requests actually came from Telegram (checked against the
# X-Telegram-Bot-Api-Secret-Token header). Set the same value when you run
# scripts/set-webhook.js.
TELEGRAM_WEBHOOK_SECRET=

# Meera's personal Telegram chat id. The bot will ignore messages from any
# other chat, so a stranger who finds the bot can't burn your API budget or
# get drafts sent to them. See README for how to find this.
ALLOWED_CHAT_ID=

# --- Model providers ---
# Required. Used for audio transcription (Gemini handles audio natively),
# and as the default drafting model.
GEMINI_API_KEY=

# Optional. Only needed if DRAFT_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Which model drafts the LinkedIn post: "gemini" (default) or "claude".
# Transcription always uses Gemini regardless of this setting.
DRAFT_PROVIDER=gemini

# Optional overrides. Sensible defaults are baked into lib/config.js.
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
# GEMINI_DRAFT_MODEL=gemini-3.5-flash
# CLAUDE_DRAFT_MODEL=claude-sonnet-4-5

# --- Automatic research ---
# Every draft automatically pulls in supporting industry news via Google
# News RSS, so Meera doesn't have to supply all the research herself. No
# key needed. Region/language bias defaults to India/English, matching
# Skinstinct's market - override if needed:
# GOOGLE_NEWS_REGION=IN
# GOOGLE_NEWS_LANGUAGE=en
